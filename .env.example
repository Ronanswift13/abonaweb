# 复制为 .env.local（本地开发）或 .env（Docker Compose 生产）。勿将真实密钥提交到仓库。

# 站点正式访问地址（用于 SEO / sitemap / canonical），在构建时写入
NEXT_PUBLIC_SITE_URL=https://www.abonatech.com

# Docker 构建时使用的 npm 镜像（国内服务器可改为 https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org

# Web 容器只绑定服务器本机，由 Nginx 反向代理；生产环境不要改成 0.0.0.0
WEB_BIND=127.0.0.1
WEB_PORT=3000

# 百度统计站点 ID（可选）：在 tongji.baidu.com 新建站点后获取 hm.js?xxxx 中的 32 位字符串；留空则不启用
NEXT_PUBLIC_BAIDU_TONGJI_ID=
